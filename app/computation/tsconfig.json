{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"], "strict": true, "noEmit": true,
    "allowImportingTsExtensions": true, "verbatimModuleSyntax": true, "resolveJsonModule": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src/**/*.ts"]
}
