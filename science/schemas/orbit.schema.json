{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "start": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "months": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "start",
    "months"
  ],
  "additionalProperties": false
}
