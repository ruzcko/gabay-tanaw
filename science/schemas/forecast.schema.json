{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "lat": {
      "type": "number",
      "exclusiveMinimum": -90,
      "exclusiveMaximum": 90
    },
    "lon": {
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 360
    },
    "horizon": {
      "enum": [
        "lola",
        "smooth"
      ]
    },
    "ephemeris": {
      "type": "string",
      "minLength": 1
    },
    "science": {
      "type": "object",
      "properties": {
        "visibility": {
          "const": "center"
        },
        "referenceFrame": {
          "const": "MOON_ME_DE421"
        },
        "frameEvidence": {
          "type": "string",
          "minLength": 1
        },
        "coordinateFrameReview": {
          "type": [
            "object",
            "null"
          ]
        },
        "positionAccuracy": {
          "const": "approximate"
        },
        "elevationDatum": {
          "const": "sphere-1737400m"
        },
        "surfaceElevationM": {
          "type": "number"
        },
        "observerHeightM": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        },
        "stepMinutes": {
          "enum": [
            1,
            10
          ]
        },
        "horizonStepDeg": {
          "enum": [
            0.25,
            0.5,
            1
          ]
        },
        "horizonSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "pattern": "^(sun|earth)-[0-9]{4}-[0-9]{2}(?:-[0-9]{2}_[0-9]{4}-[0-9]{2}-[0-9]{2})?\\.txt\\.gz$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "header": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "file",
              "sha256",
              "header"
            ],
            "additionalProperties": false
          },
          "minItems": 2
        }
      },
      "required": [
        "visibility",
        "referenceFrame",
        "frameEvidence",
        "elevationDatum",
        "surfaceElevationM",
        "observerHeightM",
        "stepMinutes",
        "horizonStepDeg",
        "horizonSha256",
        "sources"
      ],
      "additionalProperties": false
    },
    "window": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "end": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "sunUpAtStart": {
      "type": "boolean"
    },
    "earthUpAtStart": {
      "type": "boolean"
    },
    "months": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "sunHours": {
            "type": "number",
            "minimum": 0,
            "maximum": 24
          },
          "sunrise": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            }
          },
          "sunset": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            }
          },
          "sunUpAt0": {
            "type": "boolean"
          },
          "nextSunEvent": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "rise",
                      "set"
                    ]
                  },
                  "at": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "Z$"
                  }
                },
                "required": [
                  "kind",
                  "at"
                ],
                "additionalProperties": false
              }
            ]
          },
          "earthHours": {
            "type": "number",
            "minimum": 0,
            "maximum": 24
          },
          "earthrise": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            }
          },
          "earthset": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            }
          },
          "earthUpAt0": {
            "type": "boolean"
          },
          "nextEarthEvent": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "rise",
                      "set"
                    ]
                  },
                  "at": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "Z$"
                  }
                },
                "required": [
                  "kind",
                  "at"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "date",
          "sunHours",
          "sunrise",
          "sunset",
          "sunUpAt0",
          "nextSunEvent",
          "earthHours",
          "earthrise",
          "earthset",
          "earthUpAt0",
          "nextEarthEvent"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "id",
    "name",
    "lat",
    "lon",
    "horizon",
    "ephemeris",
    "science",
    "window",
    "sunUpAtStart",
    "earthUpAtStart",
    "months",
    "days"
  ],
  "additionalProperties": false
}
