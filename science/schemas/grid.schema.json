{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "hours": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 24}, "minItems": 1},
    "pct": {"type": "number", "minimum": 0, "maximum": 100}
  },
  "type": "object",
  "properties": {
    "id": {"type": "string"},
    "points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "i": {"type": "integer"},
          "j": {"type": "integer"},
          "lat": {"type": "number", "minimum": -90, "maximum": 90},
          "lon": {"type": "number", "minimum": 0, "exclusiveMaximum": 360},
          "groundM": {"type": "number"},
          "slopeDeg": {"type": "number", "minimum": 0, "maximum": 90},
          "sunPct": {"$ref": "#/$defs/pct"},
          "earthPct": {"$ref": "#/$defs/pct"},
          "sunHours": {"$ref": "#/$defs/hours"},
          "earthHours": {"$ref": "#/$defs/hours"}
        },
        "required": ["i", "j", "lat", "lon", "groundM", "slopeDeg", "sunPct", "earthPct", "sunHours", "earthHours"],
        "additionalProperties": false
      }
    }
  },
  "required": ["id", "points"],
  "additionalProperties": false
}
