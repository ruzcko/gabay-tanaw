{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "minProperties": 1,
  "additionalProperties": {
    "type": "object",
    "properties": {
      "landingUtc": {
        "type": "string",
        "format": "date-time",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
      },
      "landingSource": {
        "type": "string",
        "minLength": 1,
        "pattern": "https://\\S+$"
      }
    },
    "required": [
      "landingUtc",
      "landingSource"
    ],
    "additionalProperties": false
  }
}
